# ╔══════════════════════════════════════════════════════════════╗
# ║                        dunstrc                               ║
# ║              Adwaita-themed notification config              ║
# ╚══════════════════════════════════════════════════════════════╝

[global]
    # ── Display ──────────────────────────────────────────────────
    monitor             = 0
    follow              = mouse

    # ── Geometry & Position ───────────────────────────────────────
    width               = (300, 480)
    height              = 300
    origin              = top-right
    offset              = 16x52
    scale               = 0
    notification_limit  = 5

    # ── Visual Style ──────────────────────────────────────────────
    padding             = 14
    horizontal_padding  = 16
    text_icon_padding   = 12
    frame_width         = 1
    frame_color         = "#3d3d3d"
    gap_size            = 6
    separator_height    = 1
    separator_color     = frame
    corner_radius       = 12

    # ── Typography ────────────────────────────────────────────────
    font                = "Cantarell 10"
    line_height         = 0
    markup              = full
    format              = "<b>%s</b>\n%b"
    alignment           = left
    vertical_alignment  = center
    word_wrap           = yes
    ellipsize           = middle
    ignore_newline      = no
    stack_duplicates    = true
    hide_duplicate_count = false
    show_indicators     = yes

    # ── Icons (Adwaita) ───────────────────────────────────────────
    enable_recursive_icon_lookup = true
    icon_theme          = "Adwaita,hicolor"
    icon_position       = left
    min_icon_size       = 32
    max_icon_size       = 48

    # ── Behaviour ─────────────────────────────────────────────────
    sticky_history      = yes
    history_length      = 20
    always_run_script   = true
    title               = Dunst
    class               = Dunst
    ignore_dbusclose    = false
    force_xinerama      = false

    # ── Mouse Actions ─────────────────────────────────────────────
    mouse_left_click    = close_current
    mouse_middle_click  = do_action, close_current
    mouse_right_click   = close_all

    # ── Idle & Timeouts ───────────────────────────────────────────
    idle_threshold      = 120

    # ── Transparency ──────────────────────────────────────────────
    transparency        = 10

    # ── Progress Bar ──────────────────────────────────────────────
    progress_bar                  = true
    progress_bar_height           = 6
    progress_bar_frame_width      = 1
    progress_bar_min_width        = 150
    progress_bar_max_width        = 360
    progress_bar_corner_radius    = 4
    icon_corner_radius            = 6

    # ── Sorting ───────────────────────────────────────────────────
    sort                = yes
    indicate_hidden     = yes

    # ── Script / Browser ──────────────────────────────────────────
    dmenu               = /usr/bin/rofi -dmenu -p dunst
    browser             = /usr/bin/xdg-open

# ─────────────────────────────────────────────────────────────────────────────
# Urgency Levels
#   Adwaita palette:
#     bg-dark  #242424   surface  #303030   fg  #ffffff   fg-dim  #c0bfbc
#     blue     #3584e4   green    #33d17a   yellow #f6d32d  red  #e01b24
# ─────────────────────────────────────────────────────────────────────────────

[urgency_low]
    background          = "#242424e6"
    foreground          = "#c0bfbc"
    frame_color         = "#3d3d3d"
    timeout             = 5
    # Adwaita symbolic icon for low-priority hints
    default_icon        = dialog-information-symbolic

[urgency_normal]
    background          = "#303030f0"
    foreground          = "#ffffff"
    frame_color         = "#3584e4"
    timeout             = 8
    default_icon        = dialog-information-symbolic

[urgency_critical]
    background          = "#5c1010f5"
    foreground          = "#ffffff"
    frame_color         = "#e01b24"
    timeout             = 0
    default_icon        = dialog-error-symbolic

# ─────────────────────────────────────────────────────────────────────────────
# Application Rules
# ─────────────────────────────────────────────────────────────────────────────

# ── Spotify / music players ───────────────────────────────────────────────────
[spotify]
    appname             = Spotify
    background          = "#1a1a2ef0"
    foreground          = "#1DB954"
    frame_color         = "#1DB954"
    format              = "<b>%s</b>\n%b"
    timeout             = 6
    icon_position       = left

# ── Volume / brightness (OSD-style) ──────────────────────────────────────────
[volume]
    appname             = "volume-notify"
    timeout             = 2
    history_ignore      = true

[brightness]
    appname             = "brightness-notify"
    timeout             = 2
    history_ignore      = true

# ── Battery warnings ─────────────────────────────────────────────────────────
[battery-critical]
    summary             = "*battery*"
    urgency             = critical
    background          = "#5c1010f5"
    foreground          = "#ffffff"
    frame_color         = "#e01b24"
    default_icon        = battery-caution-symbolic

[battery-low]
    summary             = "*[Ll]ow*battery*"
    urgency             = normal
    default_icon        = battery-low-symbolic

# ── Network notifications ─────────────────────────────────────────────────────
[network-connected]
    summary             = "Connected*"
    background          = "#1a3a2af0"
    foreground          = "#33d17a"
    frame_color         = "#33d17a"
    default_icon        = network-wireless-symbolic
    timeout             = 4

[network-disconnected]
    summary             = "Disconnected*"
    urgency             = normal
    default_icon        = network-wireless-offline-symbolic
    timeout             = 6

# ── Screenshot ───────────────────────────────────────────────────────────────
[screenshot]
    appname             = "flameshot"
    timeout             = 3
    default_icon        = camera-photo-symbolic

# ── Calendar / time reminders ─────────────────────────────────────────────────
[calendar]
    appname             = "gnome-calendar"
    default_icon        = x-office-calendar-symbolic
    frame_color         = "#f6d32d"

# ── Suppress specific noise ───────────────────────────────────────────────────
[ignore-kde-noisy]
    appname             = "KDE Connect"
    summary             = "Session*"
    skip_display        = true

# ─────────────────────────────────────────────────────────────────────────────
# Experimental (dunst ≥ 1.9)
# ─────────────────────────────────────────────────────────────────────────────
[experimental]
    per_monitor_dpi     = false
